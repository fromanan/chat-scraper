{
  "manifest_version": 3,
  "name": "Chat Scraper",
  "version": "1.0.1",
  "author": "maxwell.d.jiang@gmail.com",
  "description": "Scrape and export chat history.",
  "icons": {
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": ["activeTab", "downloads", "scripting"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.messenger.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://messenger.com/*",
        "https://www.messenger.com/*",
        "https://facebook.com/messages",
        "https://facebook.com/messages/*",
        "https://www.facebook.com/messages",
        "https://www.facebook.com/messages/*",
        "https://web.facebook.com/messages",
        "https://web.facebook.com/messages/*"
      ],
      "js": ["main.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
