{
  "include": ["./src/*.ts"],
  "compilerOptions": {
    "target": "es6",
    "strict": true,
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020"],
    "types": ["chrome"]
  },
  "exclude": ["./node_modules", "./dist"]
}
